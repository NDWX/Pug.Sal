<?xml version="1.0" encoding="utf-8"?>
<!-- Anonymous Docker Hub pulls are capped per IP, which shared CI runners exhaust. The Postgres image
     comes from AWS's public mirror (PostgresDatabaseFixture.Image); Testcontainers' Ryuk reaper comes
     from the Testcontainers project's own GitHub registry. Keep the Ryuk tag in step with the
     Testcontainers package (4.15.0 uses ryuk 0.14.0). -->
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <TESTCONTAINERS_RYUK_CONTAINER_IMAGE>ghcr.io/testcontainers/ryuk:0.14.0</TESTCONTAINERS_RYUK_CONTAINER_IMAGE>
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
