	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../Pug.Sal.Data.Abstractions/Pug.Sal.Data.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.79" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="Pug.Application.Data" Version="1.4.1" />
	</ItemGroup>

</Project>
