<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Title>Pug.Sal.Data.Postgres</Title>
		<Description>PostgreSQL store for Pug.Sal: countries, subdivisions, localities and import runs, with pg_trgm similarity search.</Description>
