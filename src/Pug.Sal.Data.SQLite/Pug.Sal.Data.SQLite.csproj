<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Title>Pug.Sal.Data.SQLite</Title>
		<Description>SQLite store for Pug.Sal: countries, subdivisions, localities and import runs.</Description>
		<PackageTags>Pug Sal Address Postcode Locality SQLite Data</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../Pug.Sal.Data.Abstractions/Pug.Sal.Data.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.79" />
		<!-- For SqliteException only; the host supplies the provider factory and native bundle. -->
		<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
		<PackageReference Include="Pug.Application.Data" Version="1.4.1" />
	</ItemGroup>

</Project>
