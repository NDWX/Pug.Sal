<Project>

	<!-- Shared identity for every project. Each project sets its own Title, Description,
	     PackageTags and TargetFramework(s); test projects override IsPackable. -->
	<PropertyGroup>
		<Product>Pug.Sal</Product>
		<Authors>Andrian</Authors>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>https://github.com/NDWX/Pug.Sal.git</RepositoryUrl>
		<AssemblyVersion>0.0.0.1</AssemblyVersion>
		<FileVersion>0.0.0.1</FileVersion>
		<PackageVersion>0.0.1</PackageVersion>
		<PackageLicenseExpression>Apache-2.0+</PackageLicenseExpression>
		<License>Apache2.0</License>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

</Project>
