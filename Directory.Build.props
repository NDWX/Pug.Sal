<Project>

	<!-- Shared identity for every project. Each project sets its own Title, Description,
	     PackageTags and TargetFramework(s); test projects override IsPackable. -->
	<PropertyGroup>
		<Product>Pug.Sal</Product>
		<Authors>Andrian</Authors>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>https://github.com/NDWX/Pug.Sal.git</RepositoryUrl>
		<!-- The one version of every package. A release tag's X.Y.Z must equal it (RELEASING.md);
		     the release build passes the full version (e.g. 1.2.3-pre.<stamp>) as -p:Version. -->
		<Version>0.0.1</Version>
		<PackageLicenseExpression>Apache-2.0+</PackageLicenseExpression>
		<License>Apache2.0</License>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

</Project>
